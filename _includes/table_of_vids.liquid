<div class="row bg-dark text-light">
  <div class="col col-lg-2">Metadata</div>
  <div class="col col-lg-2">Title</div>
  <div class="col col-lg-4">Description</div>
  <div class="col col-lg-2">Notes</div>
  <div class="col col-lg-2">Links</div>
</div>
{% for vid in include.vids %}
  <div class="row" id="{{ vid.id }}">
    <div class="col-12 col-lg-2">
      <div class="row">
        <div class="col">NARA ID</div>
        <div class="col">
          {%- if vid.naid -%}
            <a href="https://catalog.archives.gov/id/{{ vid.naid }}">
              {{- vid.naid -}}
            </a>
          {%- else -%}
            -
          {%- endif %}
        </div>
      </div>
      <div class="row">
        <div class="col">IAEA ID</div>
        <div class="col">
          {%- if vid.iaea -%}
            {{ vid.iaea }}
          {%- else -%}
            -
          {%- endif %}
        </div>
      </div>
      <div class="row">
        <div class="col">Date</div>
        <div class="col">{{ vid.date }}</div>
      </div>
      <div class="row">
        <div class="col">Length</div>
        <div class="col">{{ vid.length }} mins</div>
      </div>
      <div class="row">
        <div class="col">Color</div>
        <div class="col">
          {% if vid.color %}Y{% else %}N{% endif %}
        </div>
      </div>
      {% if vid.resolution %}
        <div class="row">
          <div class="col">Resolution</div>
          <div class="col">{{ vid.resolution }}</div>
        </div>
      {% endif %}
    </div>
    <div class="col-12 col-lg-2">
      <a href="#{{ vid.id }}">&#167;</a>
      {{ vid.title }}
    </div>
    <div class="col-12 col-lg-4">
      {%- comment -%}
        Long descriptions show a preview with a disclosure to read the rest.
      {%- endcomment -%}
      {%- if vid.description.size > 500 -%}
        <details class="description">
          <summary>
            <span class="description-preview">
              {{- vid.description | truncate: 500 -}}
            </span>
            <span class="description-more">Show more</span>
            <span class="description-less">Show less</span>
          </summary>
          {{ vid.description }}
        </details>
      {%- else -%}
        {{- vid.description -}}
      {%- endif -%}
    </div>
    <div class="col-12 col-lg-2">
      <p>{{ vid.notes }}</p>
      {%- if vid.win -%}
        <p>
          <a href="{% link museum.md %}"
            ><span
              class="badge bg-success"
              title="Whatisnuclear coordinated scanning of this film"
              >Scanned by us!</span
            ></a
          >
        </p>
      {%- endif -%}
    </div>
    <div class="col-12 col-lg-2">
      {%- comment -%}
        Any post that names this film in its `films:` front matter supplies the
        announcement link, unless the catalog already carries one of its own
        (those often point at a section anchor, which is more precise).
      {%- endcomment -%}
      {%- assign announcement = null -%}
      {%- assign has_local_link = false -%}
      {%- for link in vid.links -%}
        {%- assign scheme = link.url | slice: 0 -%}
        {%- if scheme == '/' -%}
          {%- assign has_local_link = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless has_local_link -%}
        {%- assign announcement = site.posts
          | where_exp: 'post', 'post.films contains vid.id'
          | first
        -%}
      {%- endunless -%}
      {% if vid.links or announcement %}
        <ul>
          {% if announcement %}
            <li><a href="{{ announcement.url }}">Our announcement page</a></li>
          {% endif %}
          {% for link in vid.links %}
            <li>
              <a href="{{link.url}}">{{ link.name }}</a>
              {% if link.notes %} ({{ link.notes }}) {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
  <hr>
{% endfor %}

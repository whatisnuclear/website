FROM ruby:3.3-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      nodejs \
      default-jre-headless \
      unzip \
      curl && \
    rm -rf /var/lib/apt/lists/*

# Install gems
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Install vnu.jar. The release only publishes a moving "latest" tag (no
# version-numbered releases), so the validator version is refreshed whenever
# this image is rebuilt — the win-ci runner builds from this file.
RUN curl -fsSL "https://github.com/validator/validator/releases/download/latest/vnu.jar" -o /usr/local/lib/vnu.jar
